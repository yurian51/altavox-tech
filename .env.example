# Database
DATABASE_URL=postgresql://user:password@localhost:5432/altavox

# Authentication
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=your-32-character-secret-key-goes-here

# Admin access (comma-separated exact email allowlist)
ADMIN_EMAILS=admin@example.com

# Enable only temporarily during a controlled first-admin bootstrap
ADMIN_SETUP_ENABLED=false

# Optional fixed delivery charge for printed-book orders (TZS); never supplied by the browser
BOOKSTORE_FLAT_DELIVERY_FEE_TZS=
