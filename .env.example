# Required persistent database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Generate a unique random secret (32+ bytes); store only in hosting secrets.
BETTER_AUTH_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
BETTER_AUTH_URL=https://www.example.com

# Comma-separated emails of verified Altavox administrators.
BOOKSTORE_ADMIN_EMAILS=

# Required before accepting printed-book orders; amount in TZS.
BOOKSTORE_DEFAULT_DELIVERY_FEE_TZS=

NEXT_PUBLIC_SITE_URL=https://www.example.com

# Configure payment and private-storage secrets after provider onboarding.
