# Template only. Never copy real secrets into Git.
# Generate secrets with a password manager or: openssl rand -hex 32

# Control plane
ALTAVOX_PUBLIC_BASE_URL=https://cloud.example.com
ALTAVOX_DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/altavox
ALTAVOX_QUEUE_URL=redis://QUEUE_HOST:6379

# Artifact storage (S3-compatible)
ALTAVOX_S3_ENDPOINT=https://storage.example.com
ALTAVOX_S3_BUCKET=altavox-build-artifacts
ALTAVOX_S3_REGION=auto
ALTAVOX_S3_ACCESS_KEY_ID=
ALTAVOX_S3_SECRET_ACCESS_KEY=

# Git integration. Use least-privilege, installation-scoped credentials.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Deployment worker authentication. Rotate and keep server-side only.
ALTAVOX_WORKER_TOKEN=

# Observability
ALTAVOX_LOG_LEVEL=info
ALTAVOX_METRICS_ENABLED=false
